# ====================================================================
# AegisMesh Repository .gitignore
# ====================================================================

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini
*.directory

# IDE & Editor Directories
.vscode/
.idea/
*.swp
*.swo
*~
.gemini/

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# Terraform & Cloud
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
tfplan*
.terraform.lock.hcl

# Packet Tracer Temporary / Lock Files (Preserve .pkt and .pka)
*.tmp
*.temp
*.bak

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
