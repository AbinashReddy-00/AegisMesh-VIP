# ==============================================================================
# AegisMesh Example Terraform Variables
# Copy to terraform.tfvars to customize your deployment configuration
# ==============================================================================

aws_region  = "us-east-1"
environment = "dev"
name_prefix = "aegismesh"

vpc_cidr           = "10.1.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

public_subnet_cidrs      = ["10.1.1.0/24", "10.1.4.0/24"]
private_app_subnet_cidrs = ["10.1.2.0/24", "10.1.5.0/24"]
isolated_db_subnet_cidrs = ["10.1.3.0/24", "10.1.6.0/24"]

# Cost Safety: Keep false to avoid AWS NAT Gateway billing charges
enable_nat_gateway = false

# Web Tier Configuration
trusted_web_ingress_cidrs = ["0.0.0.0/0"]
enable_http               = false # HTTPS only for Zero Trust

# Application & Database Ports
app_port = 8000
db_port  = 5432

tags = {
  Organization = "Cisco-Virtual-Internship"
  Project      = "AegisMesh"
  Domain       = "Cloud-Infrastructure"
}
